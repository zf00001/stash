name: 'Listenify 增强'
desc: |-
  Listenify 增强
icon: 'https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/Listenify.png'
category: '去广告'
date: '2026-11-16'

http:
  mitm:
    - 'api.lrc.cx'
  script:
    - name: 'listenify-0'
      match: '^https://api\.lrc\.cx/(lyrics|cover)'
      type: request
      max-size: 10485760
      timeout: 10
      engine: auto

script-providers:
  listenify-0:
    url: 'https://raw.githubusercontent.com/zf00001/stash/refs/heads/main/script/listenify.js'
    interval: 86400
