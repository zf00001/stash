    - "39.106.97.84"
    - "47.95.49.75"
    - "101.201.62.20"
    - "101.201.62.26"
    - "101.201.175.228"
    - "124.250.48.3"
    - "182.92.145.50"
    - "182.92.251.113"

  url-rewrite:
    - >-
      (?i)^https:\/\/api\.xueqiu\.com\/snowpard\/launch_strategy\/query\.json\? - reject-dict
    - >-
      (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.+home_visitor_relation_config - reject-dict
    - >-
      (?i)^https:\/\/api\.xueqiu\.com\/ucprofile\/api\/user\/batchGetUserBasicInfo\.json - reject-dict
