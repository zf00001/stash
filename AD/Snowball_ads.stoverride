    - >-
      (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name response-jq delpaths([["data","trade_open_account_promotion_url"]])
    - >-
      (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name response-jq delpaths([["data","trade_unify_open_account_list"]])
    - >-
