name: |-
  Snowball_ads
desc: |-
  雪球移除开屏广告、各类广告
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Snowball.png

category: |-
  去广告

http:

  mitm:
    - "api.xueqiu.com"
    - "open.xueqiu.com"
    - "stock.xueqiu.com"
    - "fund.xueqiu.com"
