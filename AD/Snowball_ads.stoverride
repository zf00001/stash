    - >-
      (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name response-jq delpaths([["data","isitor_page_login_config"]])
    - >-
      (?i)^https:\/\/open\.xueqiu\.com\/mpaas\/config\/content\?.*timeline_tab_name response-jq delpaths([["data","open_wechat_mini_app_config"]])
