name: |-
  AmapAds
desc: |-
  高德地图去广告
icon: |-
  https://raw.githubusercontent.com/chxm1023/Script_X/main/icon/gaode.png
category: "去广告"
rules:
  - DOMAIN-SUFFIX,optimus-ads.amap.com,DIRECT

http:

  mitm:
    - "m5.amap.com"
    - "m5-zb.amap.com"
    - "center.amap.com"
    - "amap-aos-info-nogw.amap.com"
    - "ai.amap.com"

  url-rewrite:
# > 高德地图_开屏请求@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen - reject-200
# > 高德地图_首页底部信息流@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\/ - reject-dict
# > 高德地图_路线规划下方广告@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\? - reject-dict
# > 高德地图_Tip请求@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information - reject-200
# > 高德地图_通用广告请求@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution - reject
# > 高德地图_搜索框scene@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend - reject-dict
# > 高德地图_首页左上角gif@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif - reject-img
# > 高德地图_左下天气@ddgksf2013
    - >-
      ^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather - reject-dict

  script:
# > 高德地图_amdc处理@ddgksf2013
    - match: ^http:\/\/amdc\.m\.taobao\.com
      name: "amdc_22"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_底部tab栏角标@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_首页右中广告@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_附近页面@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_打车页面处理@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_首页底部处理@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_开屏广告@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_首页顶部推广@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_我的页面@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

# > 高德地图_搜索框热词@ddgksf2013
    - match: ^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword
      name: "amap_24"
      type: response
      require-body: true
      max-size: -1
      timeout: 60

script-providers:
  "amdc_22":
    url: https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amdc.js
    interval: 86400
  "amap_24":
    url: https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js
    interval: 86400
