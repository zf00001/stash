name: 'ChinaBroadnet'
desc: '中国电信'
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/refs/heads/main/App_icon/120px/ChinaTetlcom.png
category: '去广告'

http:
  mitm:
    - 'app.10099.com.cn'
  url-rewrite:
    - '^https?://app\.10099\.com\.cn/contact-web/api/version/getFlashScreenPage - reject-200'
  body-rewrite:
    - '^https?://app\.10099\.com\.cn/contact-web/api/content/qryPosterStand response-jq .data |= map(select(.posterStandName | test("中部业务菜单|导航栏|我的-特色|个人中心|客服")))'
    - '^https?://app\.10099\.com\.cn/contact-web/api/content/qryNavigationMenuList response-jq .data[]?.children |= map(select(.catalogName!="视听"))'
