name: |-
  ChinaUnicomAds
desc: |-
  ChinaUnicomAds
icon: |-
  https://github.com/Toperlock/Quantumult/raw/main/icon/Doraemon/Doraemon-1021.png

rules:
  - DOMAIN-SUFFIX,ad.10010.com,REJECT

http:

  mitm:
    - "m.client.10010.com"
    - "img.client.10010.com"

  url-rewrite:
# > 广告推送@ddgksf2013
    - >-
      ^https?:\/\/m\.client\.10010\.com\/mobileserviceimportant\/customer\/querySmartServicekhd.htm - reject
# > 新人专享@ddgksf2013
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientIndex\/api\/v1\/index\/queryIndexExclusiveOffers - reject
# > 首页瀑布流@ddgksf2013
    - >-
      ^https?:\/\/img\.client\.10010\.com\/homejingxuan12\/js\/(pubuliu|1homeView) - reject

  body-rewrite:
    - >-
      ^https?:\/\/m\.client\.10010\.com\/search_service\/search\/searchScrollWord response-jq .["113000004"]=[]
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientIndex\/homefusion\/fuInter response-jq del(.["HomeFusion.backGroundQuery"], .["HomeFusion.bottomLabel"].bottomMallKey)
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myWallet response-jq .data={}
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myPoints response-jq .data={}
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/myColorfulRingtone response-jq .data={}
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/newUserInfo response-jq .data={}
    - >-
      ^https?:\/\/m\.client\.10010\.com\/clientMyPage\/v\d\/api\/getDeviceInfo response-jq .data={}
